{
  "name": "@local/skill-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "技能工作台：看清内置技能、估算描述占用的 prompt 预算，并创建/编辑你自己放在 <DSH_HOME>/skills 的技能。",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "locale",
        "ui-layout",
        "ui-sidebar"
      ]
    }
  }
}
